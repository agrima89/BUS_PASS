# Copy to .env and fill in. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
FLASK_DEBUG=0
PORT=5000
UNIVERSITY_NAME=Demo University
UNIVERSITY_SHORT=DU
# DATABASE_PATH=instance/university_pass.db
# UPLOAD_FOLDER=uploads
# SESSION_COOKIE_SECURE=1   # enable when served over HTTPS
# Separate key for signing offline QR codes (recommended; defaults to SECRET_KEY)
QR_SIGNING_KEY=change-me-too
# Address printed inside online QR codes; set to your public URL when deployed
PUBLIC_BASE_URL=http://127.0.0.1:5000
PASS_PREFIX=DU
# random (default, not guessable) or sequential (DU-2026-00001, DU-2026-00002, ...)
PASS_NUMBER_STYLE=random
# 1 = print the pass number on the card; 0 (default) = leave blank to fill in by hand
PRINT_PASS_NUMBER=0
# 1 (default) = saving a complete student creates the pass + unique QR automatically
AUTO_ISSUE_PASS=1
# Fields that must be filled before a pass is issued
REQUIRED_FOR_PASS=photo,guardian_name,pickup_point,emergency_contact,address,valid_until

# --- Production (serve.py) ---
# HOST=127.0.0.1        # use 0.0.0.0 to allow other devices on the LAN
# PORT=8000
# TRUST_PROXY=1         # only when running behind nginx / Caddy / a cloud proxy

# 0 = no login, this PC only (default). 1 = admin login required (needed for network/online use)
REQUIRE_LOGIN=0
